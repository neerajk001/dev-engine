# Copy to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# OpenAI API key (required)
OPENAI_API_KEY=

# Model to use for the agent (default: gpt-5-mini)
# MODEL=gpt-5-mini

# Workspace/project root the agent operates in (default: current directory)
# WORKSPACE=

# Maximum LLM iterations per task (default: 25)
# MAX_ITERATIONS=25

# Maximum characters of command output returned to the model (default: 12000)
# MAX_COMMAND_OUTPUT_CHARS=12000
